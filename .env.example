# Optional local origin for future metadata; foundation works without an env file.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Firebase connection preparation. Copy the remaining values from the registered
# web app in Firebase project settings. Integration is not connected yet.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=fir-9-dojo-13400
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Server-only Gemini credential. Set in .env.local, never commit the real value.
GEMINI_API_KEY=

# Enable only after Firestore rules and the publication workflow are verified.
CONTENT_SOURCE=demo
PUBLISHING_ENABLED=false
